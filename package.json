{
  "name": "reviewpilot-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm --workspace=@reviewpilot/api run dev",
    "dev:web": "npm --workspace=@reviewpilot/web run dev",
    "docker:up": "docker compose -f docker-compose.local.yml up -d",
    "docker:down": "docker compose -f docker-compose.local.yml down"
  }
}
