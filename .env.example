# ==============================================================================
# ReviewPilot Environment Configuration
# ==============================================================================

# Server & Application
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars

# Database (PostgreSQL)
DATABASE_URL=postgres://reviewpilot:reviewpilot_secret@localhost:5433/reviewpilot_dev
DB_HOST=localhost
DB_PORT=5433
DB_NAME=reviewpilot_dev
DB_USER=reviewpilot
DB_PASSWORD=reviewpilot_secret

# Redis
REDIS_URL=redis://localhost:6380

# AI Service (FastAPI)
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_API_KEY=internal-ai-service-secret-key
OPENAI_API_KEY=
GEMINI_API_KEY=

# GitHub Integration (GitHub App / OAuth)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=

# Bitbucket Integration (Bitbucket Cloud OAuth 2.0 Consumer)
BITBUCKET_CLIENT_ID=
BITBUCKET_CLIENT_SECRET=
BITBUCKET_WEBHOOK_SECRET=
BITBUCKET_REDIRECT_URI=http://localhost:4000/api/auth/callback/bitbucket
