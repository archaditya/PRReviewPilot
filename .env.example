# ==============================================================================
# ReviewPilot Environment Configuration
# ==============================================================================

# Server & Application
NODE_ENV=production
APP_URL=https://prreviewpilot.yourdomain.com
API_URL=https://prreviewpilot.yourdomain.com
JWT_SECRET=generate-random-32-character-secret-string

# Production Port Bindings (Host ports)
API_PORT=4060
WEB_PORT=3060

# Database (PostgreSQL inside Docker)
POSTGRES_USER=prreviewpilot
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=prreviewpilot_prod

# AI Service (FastAPI)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
AI_SERVICE_API_KEY=your-internal-ai-service-secret-token

# GitHub Integration (GitHub App)
GITHUB_APP_ID=123456
GITHUB_APP_SLUG=prreviewpilot
GITHUB_CLIENT_ID=Iv1...
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret
# Either paste base64 encoded PEM (recommended, single line: base64 -w 0 key.pem) or set GITHUB_APP_PRIVATE_KEY_PATH
GITHUB_APP_PRIVATE_KEY=

# Bitbucket Integration (Bitbucket Cloud OAuth 2.0 Consumer)
BITBUCKET_CLIENT_ID=your_bitbucket_consumer_key
BITBUCKET_CLIENT_SECRET=your_bitbucket_consumer_secret
BITBUCKET_WEBHOOK_SECRET=your_bitbucket_webhook_secret
BITBUCKET_REDIRECT_URI=https://prreviewpilot.yourdomain.com/api/auth/callback/bitbucket
